# Set these in the server environment. The app does not automatically load this file.
OPENAI_API_KEY=
SOC_REVIEW_MODEL=gpt-4.1-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5050/auth/google/callback
FLASK_SECRET_KEY=
# Set COOKIE_SECURE=1 only when serving through HTTPS.
COOKIE_SECURE=0
PORT=5050
# Optional private source-file directory; defaults to ./private_uploads
LAB_UPLOAD_DIR=
# Optional model override for SEC disclosure reviews (structured JSON output required).
SEC_REVIEW_MODEL=gpt-4.1-mini
